{
  "model_name": "HistGradientBoostingClassifier",
  "library": "scikit-learn",
  "training_date_utc": "2025-11-02T12:26:23Z",
  "random_state": 42,
  "target": "Booking Status_Completed",
  "positive_class": "1",
  "feature_columns": [
    "Avg VTAT",
    "Avg CTAT",
    "Booking Value",
    "Ride Distance",
    "Driver Ratings",
    "Customer Rating",
    "Vehicle Type_Bike",
    "Vehicle Type_Go Mini",
    "Vehicle Type_Go Sedan",
    "Vehicle Type_Premier Sedan",
    "Vehicle Type_Uber XL",
    "Vehicle Type_eBike",
    "Payment Method_Credit Card",
    "Payment Method_Debit Card",
    "Payment Method_UPI",
    "Payment Method_Uber Wallet"
  ],
  "numeric_only": true,
  "dropped_non_numeric_columns": [
    "Date",
    "Time",
    "Booking ID",
    "Customer ID",
    "Pickup Location",
    "Drop Location",
    "Booking Status_Cancelled by Driver",
    "Booking Status_Incomplete",
    "Booking Status_No Driver Found"
  ],
  "input_path": "uber_data_cleaned.csv",
  "artifacts_dir": "artifacts",
  "estimator_params": {
    "categorical_features": "from_dtype",
    "class_weight": null,
    "early_stopping": "auto",
    "interaction_cst": null,
    "l2_regularization": 0.0,
    "learning_rate": 0.1,
    "loss": "log_loss",
    "max_bins": 255,
    "max_depth": null,
    "max_features": 1.0,
    "max_iter": 100,
    "max_leaf_nodes": 31,
    "min_samples_leaf": 20,
    "monotonic_cst": null,
    "n_iter_no_change": 10,
    "random_state": 42,
